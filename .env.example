# Environment configuration template for Bicycle Calibration application
# Copy to .env for local development

# PostgreSQL Database URLs (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://calibration_user:calibration_dev_password@127.0.0.1:5433/calibration_dev
TEST_DATABASE_URL=postgresql+psycopg://calibration_user:calibration_dev_password@127.0.0.1:5433/calibration_test

# Local Container PostgreSQL Settings (docker-compose)
POSTGRES_USER=calibration_user
POSTGRES_PASSWORD=calibration_dev_password
POSTGRES_DB=calibration_dev
POSTGRES_PORT=5433

# OIDC Identity Provider Configuration
# Reference local development provider: Keycloak (http://127.0.0.1:8080/realms/calibration)
# Production cloud providers: Auth0, Google Cloud Identity, AWS Cognito, etc.
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/calibration
OIDC_AUDIENCE=calibration-backend-api
OIDC_CLIENT_ID=calibration-web-client
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_JWKS_CACHE_TTL_SECONDS=3600
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_AUTO_PROVISION_USERS=true

# Frontend Client Configuration (Vite)
# Base URL for backend API requests.
# In local development: http://127.0.0.1:8000/api/v1
# In production reverse-proxy / same-origin deployments: /api/v1
# NOTE: Never store secrets, private signing keys, or credentials in VITE_ variables.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Frontend OIDC Client Configuration (Vite)
VITE_OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/calibration
VITE_OIDC_CLIENT_ID=calibration-web-client
VITE_OIDC_AUDIENCE=calibration-backend-api
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# Set to 'true' to enable local offline mock auth provider for development / testing without IdP
VITE_MOCK_AUTH=false


